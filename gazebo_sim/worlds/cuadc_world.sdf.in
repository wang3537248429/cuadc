<?xml version="1.0"?>
<sdf version="1.9">
  <world name="cuadc">
    <!-- 500 Hz is above the 400 Hz IMU / ArduPlane control loop while leaving
         enough CPU headroom for the camera and Mission Planner GUI. -->
    <physics name="cuadc_500hz" type="dart">
      <max_step_size>0.002</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <dart>
        <collision_detector>bullet</collision_detector>
      </dart>
    </physics>

    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>
    <plugin filename="gz-sim-navsat-system" name="gz::sim::systems::NavSat"/>
    <plugin filename="gz-sim-air-pressure-system" name="gz::sim::systems::AirPressure"/>
    <plugin filename="gz-sim-contact-system" name="gz::sim::systems::Contact"/>
    <plugin filename="gz-sim-wind-effects-system" name="gz::sim::systems::WindEffects">
      <!-- Gazebo Sim 7 squares a bare scalar while building its separable
           field, so this is sqrt(PAYLOAD_DRAG_RATE_S). -->
      <force_approximation_scaling_factor>@@GAZEBO_WIND_FORCE_SCALE@@</force_approximation_scaling_factor>
    </plugin>
    <plugin filename="CuadcScenarioStateSystem"
            name="cuadc::sim::ScenarioStateSystem">
      <topic>/cuadc/scenario/state</topic>
      <state>@@SCENARIO_JSON@@</state>
    </plugin>

    <spherical_coordinates>
      <latitude_deg>@@ORIGIN_LAT@@</latitude_deg>
      <longitude_deg>@@ORIGIN_LON@@</longitude_deg>
      <elevation>@@ORIGIN_ALT@@</elevation>
      <heading_deg>0</heading_deg>
      <surface_model>EARTH_WGS84</surface_model>
    </spherical_coordinates>
    <wind>
      <linear_velocity>@@WIND_VECTOR@@</linear_velocity>
    </wind>

    <scene>
      <ambient>0.48 0.51 0.56</ambient>
      <background>0.48 0.66 0.84</background>
      <!-- Shadow maps are disabled deliberately: Ogre2 Garden can produce an
           invalid directional-light frustum when the 400 m two-zone world is
           viewed by the moving downward camera.  PBR lighting remains active,
           while this removes both that crash path and the largest frame-time
           spike on integrated GPUs. -->
      <shadows>false</shadows>
      <sky/>
    </scene>
    <light type="directional" name="sun">
      <pose>0 0 300 0 0 0</pose>
      <cast_shadows>false</cast_shadows>
      <diffuse>0.94 0.91 0.83 1</diffuse>
      <specular>0.18 0.18 0.18 1</specular>
      <direction>-0.42 0.22 -0.88</direction>
    </light>

@@FIELD_SURFACES@@

    <model name="legacy_ground">
      <static>true</static>
      <link name="ground_link">
        <collision name="ground_collision">
          <geometry><plane><normal>0 0 1</normal><size>700 700</size></plane></geometry>
          <surface><friction><ode><mu>0.8</mu><mu2>0.8</mu2></ode></friction></surface>
        </collision>
        <!--
          The official ArduPilot airfield UV mesh repeats a single 2K grass
          albedo.  It replaces the flat green plane without loading normal,
          displacement or AO maps, keeping one draw surface and one sampler.
        -->
        <visual name="ground_visual">
          <pose>0 0 -0.018 0 0 0</pose>
          <cast_shadows>false</cast_shadows>
          <geometry>
            <mesh>
              <uri>model://cuadc_world_assets/meshes/airfield.dae</uri>
              <scale>0.07 0.07 1</scale>
            </mesh>
          </geometry>
          <material>
            <ambient>0.32 0.38 0.28 1</ambient>
            <diffuse>0.66 0.70 0.58 1</diffuse>
            <specular>0.025 0.025 0.025 1</specular>
            <pbr>
              <metal>
                <albedo_map>model://cuadc_world_assets/materials/textures/Grass004_2K_Color.jpg</albedo_map>
                <roughness>0.96</roughness>
                <metalness>0</metalness>
              </metal>
            </pbr>
          </material>
        </visual>
      </link>
    </model>

    <model name="legacy_takeoff_landing_area">
      <static>true</static>
      <pose>0 0 0.012 0 0 0</pose>
      <link name="marking">
        <visual name="area">
          <cast_shadows>false</cast_shadows>
          <geometry><box><size>50 50 0.02</size></box></geometry>
          <material><ambient>0.30 0.30 0.28 1</ambient><diffuse>0.38 0.38 0.35 1</diffuse><specular>0.025 0.025 0.025 1</specular><pbr><metal><roughness>0.94</roughness><metalness>0</metalness></metal></pbr></material>
        </visual>
        <visual name="centerline">
          <pose>0 0 0.018 0 0 0</pose>
          <cast_shadows>false</cast_shadows>
          <geometry><box><size>45 0.25 0.012</size></box></geometry>
          <material><ambient>0.84 0.84 0.79 1</ambient><diffuse>0.92 0.92 0.87 1</diffuse><specular>0.02 0.02 0.02 1</specular><pbr><metal><roughness>0.92</roughness><metalness>0</metalness></metal></pbr></material>
        </visual>
        <visual name="threshold_north">
          <pose>23.8 0 0.018 0 0 0</pose>
          <cast_shadows>false</cast_shadows>
          <geometry><box><size>0.35 46 0.012</size></box></geometry>
          <material><ambient>0.84 0.84 0.79 1</ambient><diffuse>0.92 0.92 0.87 1</diffuse><pbr><metal><roughness>0.92</roughness><metalness>0</metalness></metal></pbr></material>
        </visual>
        <visual name="threshold_south">
          <pose>-23.8 0 0.018 0 0 0</pose>
          <cast_shadows>false</cast_shadows>
          <geometry><box><size>0.35 46 0.012</size></box></geometry>
          <material><ambient>0.84 0.84 0.79 1</ambient><diffuse>0.92 0.92 0.87 1</diffuse><pbr><metal><roughness>0.92</roughness><metalness>0</metalness></metal></pbr></material>
        </visual>
      </link>
    </model>

    <!-- Opaque boundary strips avoid the alpha blending and near-coplanar
         surfaces that made the old 60 x 60 m translucent fills shimmer. -->
    <model name="legacy_target_zone_A">
      <static>true</static>
      <pose>200 0 0 0 0 0</pose>
      <link name="zone">
        <visual name="north"><pose>30.0 0 0.018 0 0 0</pose><cast_shadows>false</cast_shadows><geometry><box><size>0.30 60.3 0.026</size></box></geometry><material><ambient>0.055 0.19 0.58 1</ambient><diffuse>0.075 0.27 0.78 1</diffuse><pbr><metal><roughness>0.88</roughness><metalness>0</metalness></metal></pbr></material></visual>
        <visual name="south"><pose>-30.0 0 0.018 0 0 0</pose><cast_shadows>false</cast_shadows><geometry><box><size>0.30 60.3 0.026</size></box></geometry><material><ambient>0.055 0.19 0.58 1</ambient><diffuse>0.075 0.27 0.78 1</diffuse><pbr><metal><roughness>0.88</roughness><metalness>0</metalness></metal></pbr></material></visual>
        <visual name="east"><pose>0 30.0 0.018 0 0 0</pose><cast_shadows>false</cast_shadows><geometry><box><size>60.3 0.30 0.026</size></box></geometry><material><ambient>0.055 0.19 0.58 1</ambient><diffuse>0.075 0.27 0.78 1</diffuse><pbr><metal><roughness>0.88</roughness><metalness>0</metalness></metal></pbr></material></visual>
        <visual name="west"><pose>0 -30.0 0.018 0 0 0</pose><cast_shadows>false</cast_shadows><geometry><box><size>60.3 0.30 0.026</size></box></geometry><material><ambient>0.055 0.19 0.58 1</ambient><diffuse>0.075 0.27 0.78 1</diffuse><pbr><metal><roughness>0.88</roughness><metalness>0</metalness></metal></pbr></material></visual>
        <visual name="center_cross_x"><pose>0 0 0.017 0 0 0</pose><cast_shadows>false</cast_shadows><geometry><box><size>7 0.24 0.024</size></box></geometry><material><ambient>0.055 0.19 0.58 1</ambient><diffuse>0.075 0.27 0.78 1</diffuse><pbr><metal><roughness>0.88</roughness><metalness>0</metalness></metal></pbr></material></visual>
        <visual name="center_cross_y"><pose>0 0 0.017 0 0 0</pose><cast_shadows>false</cast_shadows><geometry><box><size>0.24 7 0.024</size></box></geometry><material><ambient>0.055 0.19 0.58 1</ambient><diffuse>0.075 0.27 0.78 1</diffuse><pbr><metal><roughness>0.88</roughness><metalness>0</metalness></metal></pbr></material></visual>
      </link>
    </model>
    <model name="legacy_target_zone_B">
      <static>true</static>
      <pose>-200 0 0 0 0 0</pose>
      <link name="zone">
        <visual name="north"><pose>30.0 0 0.018 0 0 0</pose><cast_shadows>false</cast_shadows><geometry><box><size>0.30 60.3 0.026</size></box></geometry><material><ambient>0.52 0.055 0.045 1</ambient><diffuse>0.75 0.075 0.06 1</diffuse><pbr><metal><roughness>0.88</roughness><metalness>0</metalness></metal></pbr></material></visual>
        <visual name="south"><pose>-30.0 0 0.018 0 0 0</pose><cast_shadows>false</cast_shadows><geometry><box><size>0.30 60.3 0.026</size></box></geometry><material><ambient>0.52 0.055 0.045 1</ambient><diffuse>0.75 0.075 0.06 1</diffuse><pbr><metal><roughness>0.88</roughness><metalness>0</metalness></metal></pbr></material></visual>
        <visual name="east"><pose>0 30.0 0.018 0 0 0</pose><cast_shadows>false</cast_shadows><geometry><box><size>60.3 0.30 0.026</size></box></geometry><material><ambient>0.52 0.055 0.045 1</ambient><diffuse>0.75 0.075 0.06 1</diffuse><pbr><metal><roughness>0.88</roughness><metalness>0</metalness></metal></pbr></material></visual>
        <visual name="west"><pose>0 -30.0 0.018 0 0 0</pose><cast_shadows>false</cast_shadows><geometry><box><size>60.3 0.30 0.026</size></box></geometry><material><ambient>0.52 0.055 0.045 1</ambient><diffuse>0.75 0.075 0.06 1</diffuse><pbr><metal><roughness>0.88</roughness><metalness>0</metalness></metal></pbr></material></visual>
        <visual name="center_cross_x"><pose>0 0 0.017 0 0 0</pose><cast_shadows>false</cast_shadows><geometry><box><size>7 0.24 0.024</size></box></geometry><material><ambient>0.52 0.055 0.045 1</ambient><diffuse>0.75 0.075 0.06 1</diffuse><pbr><metal><roughness>0.88</roughness><metalness>0</metalness></metal></pbr></material></visual>
        <visual name="center_cross_y"><pose>0 0 0.017 0 0 0</pose><cast_shadows>false</cast_shadows><geometry><box><size>0.24 7 0.024</size></box></geometry><material><ambient>0.52 0.055 0.045 1</ambient><diffuse>0.75 0.075 0.06 1</diffuse><pbr><metal><roughness>0.88</roughness><metalness>0</metalness></metal></pbr></material></visual>
      </link>
    </model>

@@SCENARIO_MODELS@@

    <include>
      <uri>model://cuadc_twin</uri>
      <name>cuadc_plane</name>
      <pose>0 0 1.55 0 0 @@PLANE_YAW@@</pose>
    </include>

    <!--
      A physical hand-launch restraint. The static anchor and detachable fixed
      joint hold the complete aircraft (including payload) without scripting
      its pose. CuadcHandLaunchSystem detaches it before applying the one-shot
      launch velocity.
    -->
    <model name="hand_launcher">
      <static>true</static>
      <pose>0 0 1.55 0 0 @@PLANE_YAW@@</pose>
      <link name="anchor">
        <visual name="grip">
          <pose>-0.18 0 -0.24 0 0 0</pose>
          <geometry><box><size>0.16 0.08 0.35</size></box></geometry>
          <material>
            <ambient>0.12 0.12 0.12 1</ambient>
            <diffuse>0.18 0.18 0.18 1</diffuse>
          </material>
        </visual>
      </link>
      <plugin filename="gz-sim-detachable-joint-system"
              name="gz::sim::systems::DetachableJoint">
        <parent_link>anchor</parent_link>
        <child_model>cuadc_plane</child_model>
        <child_link>fuselage</child_link>
        <detach_topic>/cuadc/hand_launch/detach</detach_topic>
        <output_topic>/cuadc/hand_launch/held</output_topic>
      </plugin>
    </model>
  </world>
</sdf>
